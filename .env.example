TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
OPENROUTER_API_KEY=your-openrouter-api-key
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/expense_bot
WEBHOOK_BASE_URL=https://your-domain.com
# Required when MODE=webhook — Telegram sends this token in the
# X-Telegram-Bot-Api-Secret-Token header; use a long random string.
# Allowed characters: A-Z a-z 0-9 _ - (1-256 chars).
WEBHOOK_SECRET=random-secret-for-telegram-verification
OPENROUTER_MODEL=openai/gpt-5.6-luna
WHISPER_MODEL=openai/whisper-large-v3
MODE=webhook
DEFAULT_CURRENCY=INR
# IANA timezone used for "today", month boundaries and the recurring scheduler
TIMEZONE=Asia/Kolkata
FRANKFURTER_API_URL=https://api.frankfurter.dev/v1
